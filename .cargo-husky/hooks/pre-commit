#!/bin/sh

# Pre-commit hook for Ferric
# Runs formatting checks and linting

set -e

echo "🔍 Running pre-commit checks..."

# Check if cargo fmt is available
if ! command -v cargo fmt > /dev/null 2>&1; then
    echo "⚠️  Warning: cargo fmt not available, skipping format check"
else
    echo "📝 Checking code formatting..."
    cargo fmt --all -- --check || {
        echo "❌ Code formatting check failed!"
        echo "💡 Run 'cargo fmt --all' to fix formatting issues"
        exit 1
    }
    echo "✅ Code formatting check passed"
fi

# Check if clippy is available
if ! command -v cargo clippy > /dev/null 2>&1; then
    echo "⚠️  Warning: cargo clippy not available, skipping lint check"
else
    echo "🔎 Running clippy lints..."
    cargo clippy --all-targets --all-features --workspace -- -D warnings || {
        echo "❌ Clippy found issues!"
        echo "💡 Fix the issues above before committing"
        exit 1
    }
    echo "✅ Clippy checks passed"
fi

echo "✨ All pre-commit checks passed!"

