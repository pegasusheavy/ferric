#!/bin/sh

# Commit-msg hook for Ferric
# Validates commit message format (Conventional Commits)

set -e

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

echo "📝 Validating commit message..."

# Conventional Commits pattern:
# type(scope?): subject
#
# Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
# Examples:
#   feat: add new component system
#   fix(router): resolve navigation bug
#   docs: update README with examples

# Allow merge commits
if echo "$commit_msg" | grep -qE "^Merge (branch|pull request)"; then
    echo "✅ Merge commit - validation skipped"
    exit 0
fi

# Allow revert commits
if echo "$commit_msg" | grep -qE "^Revert "; then
    echo "✅ Revert commit - validation skipped"
    exit 0
fi

# Check conventional commit format
if ! echo "$commit_msg" | grep -qE "^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?: .{1,}"; then
    echo "❌ Invalid commit message format!"
    echo ""
    echo "Commit message must follow Conventional Commits format:"
    echo "  <type>[optional scope]: <description>"
    echo ""
    echo "Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
    echo ""
    echo "Examples:"
    echo "  feat: add new component system"
    echo "  fix(router): resolve navigation bug"
    echo "  docs: update README with examples"
    echo "  refactor(core): simplify reactive system"
    echo ""
    echo "Your commit message:"
    echo "  $commit_msg"
    exit 1
fi

# Check if subject line is too long (recommended max 72 chars after type)
subject_line=$(echo "$commit_msg" | head -n1)
if [ ${#subject_line} -gt 100 ]; then
    echo "⚠️  Warning: Commit message subject line is quite long (${#subject_line} chars)"
    echo "💡 Consider keeping it under 72 characters"
fi

echo "✅ Commit message format is valid"

