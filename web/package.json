{
  "name": "ferric-docs",
  "version": "0.1.0",
  "description": "Ferric Framework Documentation Website",
  "scripts": {
    "build:css": "tailwindcss -i ./styles/rust-theme.css -o ./styles/dist/rust-theme.min.css --minify",
    "watch:css": "tailwindcss -i ./styles/rust-theme.css -o ./styles/dist/rust-theme.min.css --watch",
    "dev": "npm run watch:css"
  },
  "devDependencies": {
    "tailwindcss": "^4.0.0",
    "@tailwindcss/typography": "^0.6.0"
  }
}
