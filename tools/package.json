{
  "name": "@ferric/tools",
  "version": "0.1.0",
  "description": "Build tools for Ferric framework projects",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ferric": "./dist/cli.js"
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths",
    "watch": "swc src -d dist --strip-leading-paths -w",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@swc/core": "^1.9.0",
    "chokidar": "^3.5.3",
    "commander": "^12.0.0",
    "esbuild": "^0.24.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@swc/cli": "^0.3.12",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ferric",
    "wasm",
    "build-tools",
    "swc"
  ]
}

